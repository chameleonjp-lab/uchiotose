{
  "name": "uchiotose",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node scripts/run-unit-tests.mjs",
    "test:browser": "playwright test --config playwright.ui-only.config.ts",
    "pretest:browser": "npm run test:browser:discovery",
    "test:browser:discovery": "node scripts/check-browser-discovery.mjs playwright.ui-only.config.ts",
    "test:browser:legacy": "playwright test --config playwright.config.ts",
    "test:ui:types": "tsc --project tsconfig.ui-only.json",
    "test:long-session": "node scripts/run-unit-tests.mjs --long-session"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/three": "0.183.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
